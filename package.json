{
  "name": "aicms",
  "version": "1.0.0",
  "description": "Multi-tenant CMS with AI article writing and AI site design",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server.ts",
    "seed": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/seed.ts",
    "export": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/export.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "express": "^5.3.0",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
