# Copy to .env and fill in. Real environment variables take precedence over this file.

# Platform default LLM credentials (sites can set their own provider/key in Settings).
# Leave unset to run with the offline mock AI.
ANTHROPIC_API_KEY=

# Required in production: signs CSRF tokens and encrypts sites' stored AI API keys.
# Changing it invalidates stored keys (owners must re-enter them).
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
APP_SECRET=

# Optional — uncomment to override the defaults.
# AI_PROVIDER=anthropic        # anthropic | mock (default: anthropic if a key is set, else mock)
# AI_MODEL=claude-opus-5-5     # default model for new sites
# DB_PATH=data/aicms.sqlite
# BASE_DOMAIN=example.com      # enables subdomain tenancy: acme.example.com -> site "acme"
# PORT=3000
# NODE_ENV=production          # enables secure cookies
